# ===== vLLM Endpoints =====
# One vLLM process per model, or single process with LoRA switching.
# All endpoints use OpenAI-compatible API (/v1/chat/completions).

VLLM_AGENTS_URL=http://localhost:8001/v1
VLLM_DECOMPOSER_URL=http://localhost:8002/v1
VLLM_BASELINE_URL=http://localhost:8003/v1
VLLM_JUDGE_URL=http://localhost:8004/v1

# Model name routing strings (must match what vLLM is serving)
AGENTS_MODEL_NAME=Qwen/Qwen2.5-14B-Instruct-AWQ
DECOMPOSER_MODEL_NAME=Qwen/Qwen2.5-7B-Instruct
BASELINE_MODEL_NAME=Qwen/Qwen2.5-1.5B-Instruct
JUDGE_MODEL_NAME=Qwen/Qwen2.5-32B-Instruct

# Dummy key required by langchain-openai ChatOpenAI (vLLM ignores it)
VLLM_API_KEY=EMPTY
OPENAI_API_KEY=dummy-not-used

# ===== SQLite Database =====
SQLITE_DB_PATH=mad.db
LANGCHAIN_CACHE_DB=.langchain_cache.db

# ===== Concurrency =====
# Max claims processed in parallel per debate round
CLAIM_CONCURRENCY=2

# ===== Langfuse (optional) =====
# Leave blank to disable tracing — pipeline never crashes if missing.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://localhost:3000

# ===== RAG (optional, for live retrieval) =====
# Set if you want to use the Qdrant+BM25 RAG pipeline.
# Otherwise pass rag_chunks directly in the input JSON.
RAG_SERVICE_PATH=
BM25_PATH_OVERRIDE=
QDRANT_HOST=host.docker.internal
QDRANT_PORT=6333
QDRANT_MODE=server
