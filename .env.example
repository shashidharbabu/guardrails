# =============================================================================
# Guardrails Enterprise — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will never be committed.
# =============================================================================

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ── Gateway — Model Paths (HuggingFace Hub IDs or local dirs) ────────────────
PII_MODEL_PATH=shashidharbabu/deberta-pii-guardrails
THREAT_MODEL_PATH=shashidharbabu/roberta-jailbreak-guardrails
PROMPT_INJECTION_MODEL_PATH=shashidharbabu/llama-prompt-guard-guardrails

# ── Gateway — PEFT (base + adapter repos) ─────────────────────────────────────
# When *_USE_PEFT=true, the corresponding *_MODEL_PATH is the LoRA adapter repo id.
# Optional *_PEFT_BASE overrides the base model id (else read from adapter PeftConfig).
#
# PII (token classification + NER pipeline):
# PII_USE_PEFT=false
# PII_PEFT_BASE=
#
# Jailbreak / threat (sequence classification):
# THREAT_USE_PEFT=false
# THREAT_PEFT_BASE=
#
# Prompt injection — classifier PEFT (same as threat) OR causal LM (Qwen + LoRA):
# PI_USE_PEFT=false
# PI_PEFT_BASE=Qwen/Qwen2.5-7B-Instruct
# PI_PEFT_ARCH=causal_lm
# PROMPT_INJECTION_MODEL_PATH=harshitasayala/pi-qwen25-7b
#
# Qwen / custom code checkpoints:
# GATEWAY_HF_TRUST_REMOTE_CODE=true
# Optional: merge LoRA for faster inference (test on your stack first)
# GATEWAY_PEFT_MERGE=false
#
# Causal PI scoring (generation). Tune template to match your training / eval recipe.
# PI_CAUSAL_PROMPT_TEMPLATE=... must include {text}
# PI_CAUSAL_USE_CHAT_TEMPLATE=false
# PI_CAUSAL_MAX_NEW_TOKENS=16
# PI_CAUSAL_POSITIVE_MARKERS=MALICIOUS,INJECTION,YES,1
# PI_CAUSAL_NEGATIVE_MARKERS=BENIGN,SAFE,NO,0

# ── Qdrant (RAG vector store) ─────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=ai_governance_chunks_nemotron8b
QDRANT_TIMEOUT=60

# ── Embedding model ───────────────────────────────────────────────────────────
# Use local path if downloaded: EMBED_MODEL=/Users/you/nemotron_download
EMBED_MODEL=nvidia/llama-embed-nemotron-8b

# ── LLM — MAD Agents (via Ollama) ────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
AGENT_MODEL=qwen2.5:7b

# ── LLM — Judge ──────────────────────────────────────────────────────────────
# JUDGE_PROVIDER: 'anthropic' (recommended) or 'ollama' (offline fallback)
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# ── Langfuse — debate MAD traces (SDK; self-host or cloud) ────────────────────
# Put REAL keys only in .env (never commit .env). Use placeholders here only.
# Set LANGFUSE_ENABLED=false for local runs without a Langfuse backend.
LANGFUSE_PUBLIC_KEY=pk-lf-your_public_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_secret_key_here
LANGFUSE_BASE_URL=http://localhost:3000

# ── Datadog — Gateway APM (Python ddtrace → local Agent → Datadog) ────────────
# Install the Datadog Agent on your machine; the Agent holds DD_API_KEY in its own config.
# The gateway process usually only needs the variables below (traces to localhost:8126).
# Do NOT paste shell commands or line continuations (\) into .env — one VAR=value per line.
DD_SERVICE=gateway
DD_ENV=local
DD_TRACE_AUTO_INSTRUMENT=true
DD_TRACE_ENABLED=true
DD_TRACE_SAMPLE_RATE=1.0
DD_AGENT_HOST=127.0.0.1
# Site must match your Datadog org (Agent installer sets this; optional for the app):
# DD_SITE=us5.datadoghq.com
# Optional: LLM Observability in Datadog (see Datadog docs; not required for basic APM):
# DD_LLMOBS_ENABLED=1
# DD_LLMOBS_ML_APP=your_ml_app_name
# Only needed for some agentless / CI setups — not for normal Mac Agent + local app:
# DD_API_KEY=your_datadog_api_key_here

# Fallback JSON spans when skipping ddtrace Agent (DD_TRACE_ENABLED=false)
# GATEWAY_TELEMETRY_STDOUT=true

# ── MAD Debate settings ───────────────────────────────────────────────────────
MAX_CYCLES=2
TOP_K_CHUNKS=5
TOP_K_CHALLENGE_CHUNKS=3
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_LOW=0.4

# ── Storage ───────────────────────────────────────────────────────────────────
# Defaults to multi_agent_debate/mad_store.db if not set
# MAD_DB_PATH=/path/to/mad_store.db

# ── App backend ───────────────────────────────────────────────────────────────
APP_BACKEND_PORT=8000
GATEWAY_PORT=8080
MAD_API_PORT=8001
MAD_API_HOST=0.0.0.0
SQLITE_PATH=./guardrails.db
