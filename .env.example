# =============================================================================
# Guardrails Enterprise — Environment Variables Template
# Copy this file to .env and fill in your actual values.
# .env is gitignored and will NEVER be committed to source control.
# In production, inject secrets via Vault / AWS Secrets Manager / K8s Secrets.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
APP_ENV=development                    # development | staging | production
APP_VERSION=1.0.0
DEPLOYMENT_REGION=local

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL for staging/production:
# DATABASE_URL=postgresql://user:password@host:5432/guardrails
# SQLite for local dev only (leave DATABASE_URL unset):
SQLITE_DB_PATH=./app/app_sessions.db
SQLITE_PATH=./guardrails.db

# ── Services ─────────────────────────────────────────────────────────────────
GATEWAY_URL=http://localhost:8080
LLM_PROVIDER_TYPE=ollama               # ollama | openai | azure | custom
LLM_PROVIDER_URL=http://localhost:11434
OLLAMA_BASE_URL=http://localhost:11434/v1
DEFAULT_LLM_MODEL=qwen2.5:7b

APP_BACKEND_PORT=8000
GATEWAY_PORT=8080
MAD_API_PORT=8001
MAD_API_HOST=0.0.0.0

# ── MAD ──────────────────────────────────────────────────────────────────────
MAD_MODE=local                         # local | api | disabled
# MAD_API_URL=http://mad-service:8090
MAD_TIMEOUT_SECONDS=600
MAX_CYCLES=2
TOP_K_CHUNKS=5
TOP_K_CHALLENGE_CHUNKS=3
CONFIDENCE_THRESHOLD_HIGH=0.8
CONFIDENCE_THRESHOLD_LOW=0.4

# ── Queue (required for production durable execution) ─────────────────────────
# REDIS_URL=redis://localhost:6379/0
# QUEUE_URL=amqp://guest:guest@localhost:5672/

# ── CSE ──────────────────────────────────────────────────────────────────────
CSE_CONFIG_VERSION=1.0.0
CSE_DELIVER_THRESHOLD=0.75
CSE_HUMAN_REVIEW_THRESHOLD=0.45
CSE_MAX_RETRY_COUNT=1

# ── CORS ─────────────────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4173
# Production: CORS_ALLOWED_ORIGINS=https://guardrails.company.com

# ── Auth / OIDC ───────────────────────────────────────────────────────────────
DISABLE_AUTH=true                      # MUST be false in production
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
# OIDC_ISSUER_URL=https://auth.company.com/realms/guardrails
# OIDC_CLIENT_ID=guardrails-backend
# OIDC_AUDIENCE=guardrails-api

# ── Observability ─────────────────────────────────────────────────────────────
ENABLE_AUDIT_LOGGING=true
ENABLE_LANGFUSE=false
LANGFUSE_PUBLIC_KEY=pk-lf-your_key_here
LANGFUSE_SECRET_KEY=sk-lf-your_key_here
LANGFUSE_BASE_URL=https://cloud.langfuse.com
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
LOG_LEVEL=INFO

# ── Data ─────────────────────────────────────────────────────────────────────
DATA_RETENTION_DAYS=365
TENANT_MODE=single                     # single | multi

# ── Gateway model paths ───────────────────────────────────────────────────────
PII_MODEL_PATH=shashidharbabu/deberta-pii-guardrails
THREAT_MODEL_PATH=shashidharbabu/roberta-jailbreak-guardrails
PROMPT_INJECTION_MODEL_PATH=shashidharbabu/llama-prompt-guard-guardrails

# ── HuggingFace ───────────────────────────────────────────────────────────────
HF_TOKEN=hf_your_token_here

# ── Qdrant (RAG vector store) ─────────────────────────────────────────────────
QDRANT_URL=https://your-cluster-id.gcp.cloud.qdrant.io
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=ai_governance_chunks_nemotron8b
QDRANT_TIMEOUT=60

# ── Embedding / Verifier ─────────────────────────────────────────────────────
EMBED_MODEL=nvidia/llama-embed-nemotron-8b
VERIFIER_MODEL=qwen2.5:7b
VERIFIER_TIMEOUT=120

# ── LLM — MAD Agents (legacy Ollama pipeline) ────────────────────────────────
AGENT_MODEL=qwen2.5:7b

# ── LLM — Judge ──────────────────────────────────────────────────────────────
# JUDGE_BACKEND selects the judge backend used by the CSE Claude judge.
# "ollama"   → uses local qwen2.5:7b via Ollama (no API key needed)
# "claude"   → uses Anthropic Claude (requires ANTHROPIC_API_KEY)
JUDGE_BACKEND=ollama                   # ollama | claude
JUDGE_PROVIDER=anthropic
JUDGE_MODEL=claude-haiku-4-5-20251001
CLAUDE_JUDGE_MODEL=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=sk-ant-api03-your_key_here

# ── MAD storage ──────────────────────────────────────────────────────────────
# MAD_DB_PATH=/path/to/mad_store.db
TOP_K_RETRIEVE=7
TOP_K_VERIFIED=3

# ── full_FinalMAD_with_judge — vLLM endpoints ─────────────────────────────────
# Point these at your vLLM processes (or Ollama's OpenAI-compat endpoint).
# For local dev with Ollama: all four can point at http://localhost:11434/v1
VLLM_AGENTS_URL=http://localhost:11434/v1
VLLM_DECOMPOSER_URL=http://localhost:11434/v1
VLLM_BASELINE_URL=http://localhost:11434/v1
VLLM_JUDGE_URL=http://localhost:11434/v1

# Model names (must match what the endpoint is serving)
AGENTS_MODEL_NAME=qwen2.5:7b
DECOMPOSER_MODEL_NAME=qwen2.5:7b
BASELINE_MODEL_NAME=qwen2.5:7b
JUDGE_MODEL_NAME=qwen2.5:7b

# Required by langchain-openai ChatOpenAI (vLLM and Ollama both ignore it)
VLLM_API_KEY=EMPTY
OPENAI_API_KEY=dummy-not-used

# full_FinalMAD SQLite DB (separate from app_sessions.db)
# SQLITE_DB_PATH=./multi_agent_debate/full_FinalMAD_with_judge/mad.db
CLAIM_CONCURRENCY=2

# Langfuse tracing (optional — pipeline runs fine without it)
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=http://localhost:3000

# ── RLHF Feedback Loop ────────────────────────────────────────────────────────
# Standalone service on :8002; proxied through backend at /api/rlhf/*
FEEDBACK_API_URL=http://localhost:8002
FEEDBACK_API_HOST=0.0.0.0
FEEDBACK_API_PORT=8002

# MAD DB path (feedback loop reads same SQLite as full_FinalMAD_with_judge)
# MAD_DB_PATH=./multi_agent_debate/mad_store.db

# Human review triage band (auto_reward in this range → needs human label)
FEEDBACK_TRIAGE_LOW=-0.10
FEEDBACK_TRIAGE_HIGH=0.30

# PHI/PII penalty in reward scoring (set to 0 to skip presidio install)
FEEDBACK_USE_PRESIDIO=0

# Human review audit log
# HUMAN_FEEDBACK_LOG_PATH=./human_feedback_log.jsonl
